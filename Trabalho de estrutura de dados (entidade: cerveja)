    printf("|__________________| )\n");
    printf(" \\______prost!_____/\n");

    printf("\nDigite uma opcao:\n\n");

    printf("1 - Inserir Dados\n");
    printf("2 - Buscar Dados\n");
    printf("3 - Alterar Dados\n");
    printf("4 - Exclusao de Dados\n");
    printf("5 - Lixeira\n");
    printf("6 - Listar\n");
    printf("0 - Sair\n");
}


int main()
{
    int op;
    int n = 0;
    int capacidade = 2;

    Bier *v = malloc(capacidade * sizeof(Bier));

    if (v == NULL)
    {
        printf("Erro ao alocar memoria!\n");
        return 1;
    }

    do
    {
        Hauptmenu();

        printf("\nOpcao: ");
        scanf("%d", &op);

        switch (op)
        {
            case 1:
                Einfuegen(&v, &n, &capacidade);
                break;

            case 2:
                SuchenMenu(v, n);
                break;

            case 3:
                Aendern(v, n);
                break;

            case 4:
                Loeschen(v, n);
                break;

            case 5:
                Dlist(v, n);
                Papierkorb(v, &n);
                break;

            case 6:
                List(v, n);
                break;

            case 0:
                printf("\nEncerrando o programa. Prost!\n");
                break;

            default:
                printf("\nOpcao invalida!\n");
                break;
        }

        printf("\n");

    } while (op != 0);

    free(v);

    return 0;
}
